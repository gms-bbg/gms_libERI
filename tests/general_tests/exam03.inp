! Exam 03:
! Ten water molecules far from home with the cc-pVTZ basis set
! We are only interested in the first iteration energy to test
! the correctness of the two-electron integrals
!
 $CONTRL SCFTYP=RHF RUNTYP=ENERGY $END
 $CONTRL MAXIT=1 MULT=1 ISPHER=1 $END
 $CONTRL NPRINT=-5 $END
 $SYSTEM mwords=500 memddi=500 $END
 $BASIS GBASIS=cct $END
