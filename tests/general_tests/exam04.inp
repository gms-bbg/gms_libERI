! Exam 04:
! A tetrasilatetrahedrane dimer with the 6-31G(3df,3pd) basis set.
! We are only interested in the first iteration energy to test
! the correctness of the two-electron integrals
!
 $CONTRL SCFTYP=RHF RUNTYP=ENERGY EXETYP=RUN $END
 $CONTRL MAXIT=1 MULT=1 ISPHER=1 NOSYM=1 NPRINT=-5 $END
 $SYSTEM TIMLIM=525600 MWORDS=100 MEMDDI=100 $END
 $GUESS GUESS=HUCKEL $END
 $SCF DIRSCF=.TRUE. $END
