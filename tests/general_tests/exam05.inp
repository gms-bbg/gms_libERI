! Exam 05:
! An ionic liquid containing two cations and one anion with a
! manually truncated version of the cc-pVQZ basis set.
! We are only interested in the first iteration energy to test
! the correctness of the two-electron integrals
!
 $contrl
  scftyp=rhf
  runtyp=energy
  icharg=1
  coord=unique
  units=angs
  maxit=1
  ispher=1
  nprint=-5
 $end
 $system
  mwords=1000
  memddi=1000
 $end
 $scf
  dirscf=.t.
 $end
 $DATA
